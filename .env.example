# ---------------------------------------------------------------------------
# Online Complaint Registration & Management System - environment template
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed.
#
#   cp .env.example .env
#
# Every option below works with entirely free software and free services.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Generate a fresh key for every deployment:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-freshly-generated-50-character-secret-key

DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Required when serving over HTTPS behind a proxy, e.g. https://complaints.mao.edu.pk
CSRF_TRUSTED_ORIGINS=

# --- Database ---------------------------------------------------------------
# `sqlite` (default) needs no server at all and is perfect for the demo and for
# a small college deployment. Switch to `mysql` for MySQL 8 Community Edition
# (also free); the driver is PyMySQL, so no compiler is required.
DB_ENGINE=sqlite

DB_NAME=complaint_system
DB_USER=complaint_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Email (FR-9) -----------------------------------------------------------
# Development: print emails to the console - no account, no server, no cost.
#   django.core.mail.backends.console.EmailBackend
# Production: Gmail SMTP with a free App Password (free forever, no card).
#   django.core.mail.backends.smtp.EmailBackend
#
# How to get a free Gmail App Password:
#   1. Enable 2-Step Verification on the Google account.
#   2. Go to Google Account -> Security -> App passwords.
#   3. Create a password for "Mail", and paste the 16 characters below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Complaint Portal <no-reply@mao-college.local>

# Dispatch email on a worker thread so a slow SMTP server never delays a request.
NOTIFICATIONS_ASYNC=True

# --- Security ---------------------------------------------------------------
# Failed logins allowed before django-axes locks the account + IP.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# Set to False only if TLS terminates somewhere that cannot forward the scheme.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Uploads (FR-4) ---------------------------------------------------------
# Maximum attachment size in megabytes. Only PDF, JPG and PNG are accepted.
MAX_UPLOAD_SIZE_MB=5
